{
  "id": "./",
  "name": "Texture Pack Maker",
  "short_name": "Pack Maker",
  "description": "Make Minecraft texture packs, skins and shaders, for Java and Bedrock. Free, no account, works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0d0f14",
  "theme_color": "#0d0f14",
  "categories": ["games", "utilities", "design", "graphics"],
  "prefer_related_applications": false,
  "handle_links": "auto",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "edge_side_panel": { "preferred_width": 480 },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "screenshots/app/wide-textures.webp", "sizes": "1280x720", "type": "image/webp", "form_factor": "wide", "label": "Texture pack editor: repaint a block on its 3D model" },
    { "src": "screenshots/app/wide-skins.webp", "sizes": "1280x720", "type": "image/webp", "form_factor": "wide", "label": "Skin editor with a live 3D preview" },
    { "src": "screenshots/app/wide-shaders.webp", "sizes": "1280x720", "type": "image/webp", "form_factor": "wide", "label": "Shader maker with a live preview" },
    { "src": "screenshots/app/wide-home.webp", "sizes": "1280x720", "type": "image/webp", "form_factor": "wide", "label": "Texture packs, skins and shaders for Java and Bedrock" },
    { "src": "screenshots/app/narrow-home.webp", "sizes": "540x1170", "type": "image/webp", "form_factor": "narrow", "label": "Texture packs, skins and shaders for Java and Bedrock" },
    { "src": "screenshots/app/narrow-textures.webp", "sizes": "540x1170", "type": "image/webp", "form_factor": "narrow", "label": "Make a texture pack on your phone" },
    { "src": "screenshots/app/narrow-skins.webp", "sizes": "540x1170", "type": "image/webp", "form_factor": "narrow", "label": "Paint a skin on your phone" }
  ],
  "shortcuts": [
    { "name": "New texture pack", "short_name": "Texture pack", "description": "Make or open a texture pack", "url": "./textures/", "icons": [{ "src": "icons/shortcut-textures.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Texture pack converter", "short_name": "Converter", "description": "Convert a pack between Java and Bedrock or to another version", "url": "./texture-pack-converter/", "icons": [{ "src": "icons/shortcut-converter.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Skin editor", "short_name": "Skins", "description": "Paint a skin or make a skin pack", "url": "./skins/", "icons": [{ "src": "icons/shortcut-skins.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Shader maker", "short_name": "Shaders", "description": "Make Iris, OptiFine, vanilla or Vibrant Visuals shaders", "url": "./shaders/", "icons": [{ "src": "icons/shortcut-shaders.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "file_handlers": [
    {
      "action": "./textures/",
      "name": "Minecraft pack",
      "accept": {
        "application/zip": [".zip"],
        "application/x-minecraft-pack": [".mcpack"],
        "application/x-minecraft-addon": [".mcaddon"]
      },
      "icons": [{ "src": "icons/shortcut-textures.png", "sizes": "96x96", "type": "image/png" }],
      "launch_type": "single-client"
    },
    {
      "action": "./skins/",
      "name": "Minecraft skin",
      "accept": { "image/png": [".png"] },
      "icons": [{ "src": "icons/shortcut-skins.png", "sizes": "96x96", "type": "image/png" }],
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "name": "Texture Pack Maker project or backup",
      "accept": {
        "application/vnd.texturepackmaker.project": [".tpmproject"],
        "application/vnd.texturepackmaker.backup": [".tpmbackup"]
      },
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [".zip", ".mcpack", ".mcaddon", ".png", ".tpmproject", ".tpmbackup", "application/zip", "application/octet-stream", "image/png"]
        }
      ]
    }
  }
}
